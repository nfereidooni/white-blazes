# Copy to .env.local and fill in from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The "Publishable key" (older CLI versions call it the "anon key").
# Safe to expose in the browser: Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "off" on the live site until an email sender (like Resend) is set up.
# NEXT_PUBLIC_EMAIL_SIGNIN=off
